# Copy this file to ".env" and fill in your values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Access control (recommended when DEPLOYED) -----------------------------
# Teammates set their OWN password — no admin ever types or hashes it. To let
# someone in: invite their email below, they'll set up their account (choose a
# username + password themselves) the first time they open the app. Once
# someone is logged in, invite everyone else from the "Manage access" tab
# instead of editing this file by hand.
# Leave both of these blank to skip the login screen entirely (local dev).
AUTH_PRE_AUTHORIZED=["you@company.com"]
# Any random string — signs the login session cookie. Set once, keep stable
# (changing it logs everyone out).
AUTH_COOKIE_KEY=
# Filled in automatically once people register — don't edit by hand.
AUTH_USERS=

# --- GA4 (Google Analytics 4) -----------------------------------------------
# The numeric property ID (Admin → Property Settings). Digits only, e.g. 123456789.
GA4_PROPERTY_ID=

# Absolute path to the service-account JSON key file you downloaded from Google
# Cloud. Keep this file OUTSIDE any shared/synced folder.
GA4_SERVICE_ACCOUNT_JSON=/Users/you/keys/cpai-ga4-service-account.json

# --- Anthropic (optional) ---------------------------------------------------
# If set, the "written analysis" is generated by Claude over the computed
# numbers. If blank, a deterministic rule-based narrative is used instead.
ANTHROPIC_API_KEY=

# --- Persistent history storage (only needed when DEPLOYED) -----------------
# Uploaded periods must live somewhere permanent on the web (Streamlit Cloud
# wipes local disk on restart). Leave ALL of these blank to use local disk
# (the default when running on your own machine). Pick ONE backend:
#
# Option A — GitHub (free, no billing). Stores files on a separate branch.
GITHUB_TOKEN=
GITHUB_REPO=noyagazelle/cpai-marketing-dashboard
GITHUB_BRANCH=data
#
# Option B — Amazon S3 (the choice on an AWS deploy). The container's AWS
# credentials need s3:GetObject/PutObject/ListBucket/DeleteObject on this bucket.
S3_BUCKET=
#
# Option C — Google Cloud Storage (needs billing enabled).
GCS_BUCKET=
