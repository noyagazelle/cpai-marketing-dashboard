# Copy this file to ".env" and fill in your values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- GA4 (Google Analytics 4) -----------------------------------------------
# The numeric property ID (Admin → Property Settings). Digits only, e.g. 123456789.
GA4_PROPERTY_ID=

# Absolute path to the service-account JSON key file you downloaded from Google
# Cloud. Keep this file OUTSIDE any shared/synced folder.
GA4_SERVICE_ACCOUNT_JSON=/Users/you/keys/cpai-ga4-service-account.json

# --- Anthropic (optional) ---------------------------------------------------
# If set, the "written analysis" is generated by Claude over the computed
# numbers. If blank, a deterministic rule-based narrative is used instead.
ANTHROPIC_API_KEY=

# --- Persistent history storage (only needed when DEPLOYED) -----------------
# Name of a Google Cloud Storage bucket to store uploaded periods in, so they
# persist on Streamlit Cloud (whose local disk is wiped on restart). Leave blank
# to use local disk (the default when running on your own machine).
GCS_BUCKET=
